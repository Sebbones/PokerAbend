{
  "name": "pokerabend",
  "version": "2.0.0",
  "description": "Spieleabend für die Freundesgruppe – Karten-, Würfel-, Brett- und Partyspiele im Browser, dazu lokale Einzelspieler",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test:fast": "node scripts/test-fast.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "playwright test",
    "test:smoke": "playwright test test/ui/smoke.spec.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "socket.io-client": "^4.8.4"
  }
}
